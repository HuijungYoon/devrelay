{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/block-redmine-rest-writes.mjs\"",
            "timeout": 10,
            "statusMessage": "Redmine 쓰기 경로 확인"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/block-redmine-rest-writes.mjs\"",
            "timeout": 10,
            "statusMessage": "Redmine 쓰기 경로 확인"
          }
        ]
      }
    ]
  }
}
